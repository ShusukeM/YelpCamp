<% layout('layouts/boilerplate') %>
    <div>
        <a href="/campgrounds/new">create</a>
    </div>
    <h1>campgrounds list</h1>
    <% for (let campground of campgrounds) { %>
        <div class="card mb-3">
            <div class="row">
                <div class="col-md-4">
                    <img class="img-fluid" src="<%= campground.images[0].url %>" alt="">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= campground.title %>
                        </h5>
                        <p class="card-tect">
                            <%= campground.description%>
                        </p>
                        <p class="card-text">
                            <small class="text-muted">
                                <%= campground.location %>
                            </small>
                        </p>
                        <a href="/campgrounds/<%=campground._id%>" class="btn btn-primary">detail of
                            <%=campground.title%></a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>