<% layout('layouts/boilerplate') %>
    <div class="row">
        <h1 class="text-center">
            Edit
        </h1>
        <div class="offset-3 col-6">

        </div>
    </div>
    <form action="/campgrounds/<%=campground._id%>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label" for="title">title</label>
            <input class="form-control" type="text" name="campground[title]" id="title" value=<%=campground.title%>
            required>
        </div>
        <div>
            <label class="form-label" for="location">location</label>
            <input class="form-control" type="text" name="campground[location]" id="location"
                value=<%=campground.location%> required>
        </div>
        <div class="mb-3">
            <label class="form-label" for="location">upload images</label>
            <input class="form-control" type="file" name="image" id="image" multiple>
        </div>
        <div class="mb-3">
            <% campground.images.forEach(function (img, i) {%>
                <div class="form-check-inline">
                <img src="<%= img.thumbnail %>" class="img-thumbnail" alt="">
                    <input type="checkbox" name="deleteImages[]" id="<%= i %> " value="<%= img.filename %>">
                    <label for="<%= i %> ">delete</label>
                </div>
                <% }); %>
        </div>
        <div class="mb-3">
            <label for="price" class="form-label">price</label>
            <div class="input-group">
                <span class="input-group-text" id="price">yen</span>
                <input type="text" class="form-control" id="price" placeholder="0" aria-label="price"
                    aria-describedby="price-label" name="campground[price]" value=<%=campground.price%> required>
            </div>
        </div>
        <div>
            <label class="form-label" for="description">description</label>
            <textarea class="form-control" type="text" name="campground[description]" id="description" required>
            <%=campground.description%>
        </textarea>
        </div>
        <button class="btn-success">edit</button>
    </form>
    <div>
        <a href="/campgrounds">back to list</a>
    </div>